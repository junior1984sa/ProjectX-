# ═══════════════════════════════════════════
# SUPABASE (obrigatório)
# ═══════════════════════════════════════════
# Encontre em: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_publica_aqui

# ═══════════════════════════════════════════
# MERCADO PAGO (obrigatório para cobrança)
# ═══════════════════════════════════════════
# Public Key: usada no FRONTEND para tokenizar o cartão do usuário
# diretamente no navegador (o número do cartão nunca passa pelo
# nosso backend). É segura para expor — diferente do Access Token.
# Encontre em: https://www.mercadopago.com.br/developers/panel > Sua aplicação > Credenciais
VITE_MERCADOPAGO_PUBLIC_KEY=TEST-sua-public-key-aqui

# ═══════════════════════════════════════════
# VALORES DOS PLANOS (em reais, editável)
# ═══════════════════════════════════════════
VITE_PRECO_PLANO_MENSAL=99.00
VITE_PRECO_PLANO_ANUAL=950.00

# ═══════════════════════════════════════════
# ATENÇÃO: as chaves abaixo NUNCA vão no frontend!
# Elas são configuradas como "secrets" nas
# Supabase Edge Functions, não neste arquivo .env
# do projeto React. Veja SUPABASE_SETUP.md
# ═══════════════════════════════════════════
# MERCADOPAGO_ACCESS_TOKEN=TEST-sua-access-token-secreta
# URL_BASE_APP=http://localhost:5173
# PRECO_PLANO_MENSAL=99.00
# PRECO_PLANO_ANUAL=950.00
# DIAS_TRIAL=5
